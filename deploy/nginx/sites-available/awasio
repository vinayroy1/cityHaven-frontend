# ==============================================================================
# Upstream Definitions with Connection Keepalive
# ==============================================================================
upstream awasio_backend_upstream {
    server 127.0.0.1:4000;
    keepalive 128;
}

upstream awasio_frontend_upstream {
    server 127.0.0.1:3000;
    keepalive 64;
}

# ==============================================================================
# 1. Main Canonical HTTPS Server for awasio.com
# ==============================================================================
server {
    server_name awasio.com;
    client_max_body_size 50M;

    # ==========================================================================
    # PRIORITY 1: Explicit Bypasses for Private, Authenticated & Admin Paths
    # (Matches first to guarantee private data is NEVER cached)
    # ==========================================================================
    location ~* ^/api/v1/(propertyListing/(my|org|me|media|unlocked-contact|unlock-contact)|blog/admin|advisors/(me|admin)|projects/(me|media)|flatmates/me) {
        limit_req zone=api_general_limit burst=100 nodelay;
        proxy_pass http://awasio_backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Cache-Status "BYPASS" always;
    }

    # ==========================================================================
    # PRIORITY 2: Static Platform Reference & Locality Data (High TTL: 5m - 10m)
    # ==========================================================================

    # Cities, Localities & Detection (/api/v1/cities, /api/v1/cities/1/localities)
    location ~* ^/api/v1/(cities|detect-city) {
        limit_req zone=api_general_limit burst=100 nodelay;
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_metadata_cache;
        proxy_cache_valid 200 10m;
        proxy_pass http://awasio_backend_upstream;
    }

    # Global Billing Platform Config & Pricing Plans
    location ~* ^/api/v1/(billing/platform-config|billing/plans) {
        limit_req zone=api_general_limit burst=100 nodelay;
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_metadata_cache;
        proxy_cache_valid 200 60s;
        proxy_pass http://awasio_backend_upstream;
    }

    # ==========================================================================
    # PRIORITY 3: Search Autocomplete, Suggestions & Search Listings
    # ==========================================================================

    # Autocomplete suggestions (high keystroke frequency)
    location ~* ^/api/v1/search/suggestions {
        limit_req zone=api_search_limit burst=60 nodelay;
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_search_cache;
        proxy_cache_valid 200 120s;
        proxy_pass http://awasio_backend_upstream;
    }

    # Property Search & Location-based Geo Search
    location ~* ^/api/v1/propertyListing/(search|searchByLocation|suggest|resolve-seo-slug) {
        limit_req zone=api_search_limit burst=60 nodelay;
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_search_cache;
        proxy_cache_valid 200 30s;
        proxy_pass http://awasio_backend_upstream;
    }

    # ==========================================================================
    # PRIORITY 4: Public Detail Pages (PDP), Content, Blog, Advisors & Flatmates
    # ==========================================================================

    # Public Property Detail Page (PDP) & Similar Properties Carousel
    location ~* ^/api/v1/propertyListing/([^/]+)(/similar)?$ {
        limit_req zone=api_search_limit burst=60 nodelay;
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_pdp_cache;
        proxy_cache_valid 200 30s;
        proxy_pass http://awasio_backend_upstream;
    }

    # Public Blog (Directory & Article Slugs)
    location ~* ^/api/v1/blog {
        limit_req zone=api_general_limit burst=100 nodelay;
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_pdp_cache;
        proxy_cache_valid 200 5m;
        proxy_pass http://awasio_backend_upstream;
    }

    # Public Advisors (Directory & Profile Slugs)
    location ~* ^/api/v1/advisors {
        limit_req zone=api_general_limit burst=100 nodelay;
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_pdp_cache;
        proxy_cache_valid 200 2m;
        proxy_pass http://awasio_backend_upstream;
    }

    # Public Projects (Search & Project Detail Slugs)
    location ~* ^/api/v1/projects {
        limit_req zone=api_search_limit burst=60 nodelay;
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_pdp_cache;
        proxy_cache_valid 200 60s;
        proxy_pass http://awasio_backend_upstream;
    }

    # Public Flatmates (Search & Room Detail Slugs)
    location ~* ^/api/v1/flatmates {
        limit_req zone=api_search_limit burst=60 nodelay;
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_pdp_cache;
        proxy_cache_valid 200 30s;
        proxy_pass http://awasio_backend_upstream;
    }

    # ==========================================================================
    # PRIORITY 5: Default Backend API Proxy (Dynamic, User-Specific, Mutating)
    # 100% Real-Time - Never Cached
    # ==========================================================================
    location /api/v1/ {
        limit_req zone=api_general_limit burst=100 nodelay;
        proxy_pass http://awasio_backend_upstream/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Cache-Status "BYPASS" always;
    }

    # Backend Swagger Docs
    location /api-documentation {
        proxy_pass http://awasio_backend_upstream/api-documentation;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ==========================================================================
    # PRIORITY 6: Frontend Next.js Static Optimization & SEO Assets
    # ==========================================================================

    # Immutable hashed JS / CSS / Fonts
    location /_next/static/ {
        proxy_pass http://awasio_frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Next.js Optimized Images Cache
    location /_next/image {
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_static_cache;
        proxy_cache_valid 200 7d;
        proxy_pass http://awasio_frontend_upstream;
        add_header Cache-Control "public, max-age=604800";
    }

    # Sitemaps & Robots (Aggressively scraped by crawlers)
    location ~* ^/(sitemap.*\.xml|robots\.txt|favicon\.ico)$ {
        include /etc/nginx/snippets/api-cache-common.conf;
        proxy_cache awasio_metadata_cache;
        proxy_cache_valid 200 1h;
        proxy_pass http://awasio_frontend_upstream;
        add_header Cache-Control "public, max-age=3600";
    }

    # Prevent indexing of private dashboard and administrative routes
    location ~* ^/(dashboard|admin|auth|login) {
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass http://awasio_frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend Next.js Default Proxy
    location / {
        proxy_pass http://awasio_frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/awasio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/awasio.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# ==============================================================================
# 2. Redirect www.awasio.com and direct IP traffic to canonical https://awasio.com
# ==============================================================================
server {
    listen [::]:443 ssl;
    listen 443 ssl;
    server_name www.awasio.com 95.111.252.156;

    ssl_certificate /etc/letsencrypt/live/awasio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/awasio.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://awasio.com$request_uri;
}

# ==============================================================================
# 3. HTTP (port 80) Redirect to canonical https://awasio.com
# ==============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name awasio.com www.awasio.com 95.111.252.156 _;

    return 301 https://awasio.com$request_uri;
}
