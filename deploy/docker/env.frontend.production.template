# ==============================================================================
# Awasio Frontend Production Environment Template
# Save this file to /opt/awasio/.env.frontend on the VPS
# ==============================================================================

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000

# API Routing
NEXT_PUBLIC_API_URL=https://awasio.com/api
INTERNAL_API_URL=http://awasio-backend:4000/api

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT=true
# NEXT_PUBLIC_G_SECRET=your_google_maps_key_optional

# Cashfree Client SDK Configuration
NEXT_PUBLIC_CASHFREE_MODE=production
