# ==============================================================================
# Awasio Backend Production Environment Template
# Save this file to /opt/awasio/.env.backend on the VPS
# ==============================================================================

NODE_ENV=production
PORT=4000
FRONTEND_URL=https://awasio.com

# Database Connection (Docker PostgreSQL on awasio-net)
DATABASE_URL=postgresql://awasio_prod:your_secure_db_password_here@postgres:5432/awasio_prod_db

# Redis Cache & Session Store
REDIS_HOST=redis
REDIS_PORT=6379

# OpenSearch Property Index
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_INDEX_NAME=awasio_properties_v1

# Security & Tokens
JWT_SECRET=your_jwt_secret_token_here
G_SECRET=

# Cloudflare R2 Media Storage
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_cloudflare_access_key_here
R2_SECRET_ACCESS_KEY=your_cloudflare_secret_access_key_here
R2_BUCKET_NAME=awasio-media
R2_ENDPOINT=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your_r2_public_domain_here.dev
R2_API_TOKEN=your_cloudflare_api_token_here

# Cashfree Production Payment Gateway
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENVIRONMENT=PRODUCTION
CASHFREE_API_VERSION=2023-08-01

# Observability (Grafana Loki & Sentry)
ENABLE_SENTRY=false
GRAFANA_LOKI_URL=https://logs-prod-028.grafana.net
GRAFANA_LOKI_USER=your_grafana_user_id_here
GRAFANA_LOKI_API_KEY=your_grafana_loki_api_token_here
