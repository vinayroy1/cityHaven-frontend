# Example Environment Configuration for Awasio Frontend
# Copy this to .env.local for local development. Do not commit actual secrets or production files.

# API Endpoints
NEXT_PUBLIC_API_URL=http://localhost:4000/api
INTERNAL_API_URL=http://localhost:4000/api

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_OTP_FLOW=false

# Google Maps / Places API Key (Client-side)
NEXT_PUBLIC_G_SECRET=your_google_maps_api_key_here
